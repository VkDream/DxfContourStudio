# DxfContourStudio
# Normalize line endings and file types for a C# WPF repository.

* text=auto

*.cs    text eol=crlf
*.xaml  text eol=crlf
*.csproj text eol=crlf
*.sln   text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.json  text eol=crlf
*.md    text eol=crlf
*.yml   text eol=crlf
*.yaml  text eol=crlf
*.dxf   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.dll   binary
*.pdb   binary
