<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colors.xaml — the single palette for the whole UI (replaces the old
        ThemeResources.xaml). Keys are semantic (AppBackground, TextPrimary,
        PrimaryAccent, ...) so markup states intent, not hue. The old
        Color.* / Viewport.* keys still exist below as compatibility aliases
        (marked obsolete): CadViewport resolves its pens by string key at
        runtime, so those keys must not be removed until the viewport is
        migrated.

        Design tokens (light industrial):
          AppBackground      window / content backgrounds          #FFFFFF
          PanelBackground    toolbars, side panels                 #FAFAFA
          ViewportBackground CAD canvas                            #FAFAFA
          PrimaryAccent      brand blue (frame, active items)      #2D5F8A
          SelectionColor     selected entity / highlight           #E07818
          DiagnosticWarning  warnings (small gaps, branches)       #C98A1B
          DiagnosticError    errors (open chains, zero length)     #C0392B
    -->

    <!--  semantics: surfaces  -->
    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ViewportBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F4F4F4"/>

    <!--  semantics: accents  -->
    <SolidColorBrush x:Key="PrimaryAccent" Color="#2D5F8A"/>
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="#3A6F9E"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionColor" Color="#E07818"/>
    <SolidColorBrush x:Key="DiagnosticWarning" Color="#C98A1B"/>
    <SolidColorBrush x:Key="DiagnosticError" Color="#C0392B"/>

    <!--  D17 editing-tool overlay: normal preview / removal / extension  -->
    <SolidColorBrush x:Key="Tool.PreviewBrush" Color="#508CDC"/>
    <SolidColorBrush x:Key="Tool.RemoveBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="Tool.ExtendBrush" Color="#3CA06E"/>

    <!--  semantics: borders & text  -->
    <SolidColorBrush x:Key="BorderNormal" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#DCDCDC"/>

    <!--  viewport / selection visuals (string keys used by CadViewport)  -->
    <SolidColorBrush x:Key="Viewport.BackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Viewport.GeometryBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Viewport.SelectedBrush" Color="#E07818"/>
    <SolidColorBrush x:Key="Viewport.PrimaryBrush" Color="#E8341C"/>
    <SolidColorBrush x:Key="Viewport.DragPreviewBrush" Color="#5A78DC"/>
    <SolidColorBrush x:Key="Viewport.EmptyStateTextBrush" Color="#8A8A8A"/>

    <!--  diagnostics overlay  -->
    <SolidColorBrush x:Key="Diagnostic.OpenEndpointBrush" Color="#E07818"/>
    <SolidColorBrush x:Key="Diagnostic.GapConnectorBrush" Color="#E07818"/>
    <SolidColorBrush x:Key="Diagnostic.ErrorBrush" Color="#C0392B"/>

    <!--  snap overlay (D13B: one brush, distinct marker shapes per kind)  -->
    <SolidColorBrush x:Key="Snap.MarkerBrush" Color="#00A6B4"/>

    <!--  grip overlay (D13B): blue handle on white fill, accent when hovered  -->
    <SolidColorBrush x:Key="Grip.HandleBrush" Color="#2D5F8A"/>
    <SolidColorBrush x:Key="Grip.HoverBrush" Color="#E8341C"/>
    <SolidColorBrush x:Key="Grip.FillBrush" Color="#FFFFFF"/>

    <!--  layer panel  -->
    <SolidColorBrush x:Key="Layer.HeaderBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Layer.HoverBrush" Color="#F2F6FA"/>

    <!--  toolbar icon stroke  -->
    <SolidColorBrush x:Key="Toolbar.IconBrush" Color="#444444"/>

    <!-- ================================================================
         Compatibility aliases (OBSOLETE — new markup must use the
         semantic keys above). Kept so the existing viewport code and
         older panels keep resolving without changes.
         ================================================================ -->
    <SolidColorBrush x:Key="Color.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Color.BackgroundAlt" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Color.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Color.BorderStrong" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="Color.Text" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Color.TextMuted" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Color.TextDisabled" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Color.Separator" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Color.Accent" Color="#2D5F8A"/>
    <SolidColorBrush x:Key="Color.AccentHover" Color="#3A6F9E"/>
    <SolidColorBrush x:Key="Color.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Color.Warning" Color="#C98A1B"/>
    <SolidColorBrush x:Key="Color.Error" Color="#C0392B"/>
    <SolidColorBrush x:Key="StatusBar.BackgroundBrush" Color="#F4F4F4"/>

</ResourceDictionary>
