<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Typography.xaml — fonts and text metrics. Uses the system UI font only
        (no bundled/commercial font files), which matches zh-CN and en-US.
        Line heights and sizes are centralized so panels stay visually even.
    -->

    <FontFamily x:Key="Font.App">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Monospace">Consolas, Microsoft YaHei UI</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Small">11</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Normal">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Large">13</sys:Double>

    <Style x:Key="Typography.Window" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="Typography.SmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}"/>
    </Style>

</ResourceDictionary>
