<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Toolbar.xaml — toolbar-specific resources: the vector icon set and the
        icon button style. All icons are original 16x16 stroke geometries drawn
        for this project (no third-party icon font or asset is used). They are
        rendered at runtime by WPF so every DPI stays crisp.
    -->

    <!-- icon geometries (16x16 design grid) -->
    <Geometry x:Key="Icon.Open">M 1,3 L 6,3 L 8,5 L 15,5 L 15,13 L 1,13 Z</Geometry>
    <Geometry x:Key="Icon.Save">M 2,1 L 14,1 L 14,15 L 2,15 Z M 3,1 L 3,6 L 13,6 L 13,1</Geometry>
    <Geometry x:Key="Icon.Undo">M 5,2 L 1,6 L 5,10 M 1,6 L 9,6 Q 14,6 12,11</Geometry>
    <Geometry x:Key="Icon.Redo">M 11,2 L 15,6 L 11,10 M 15,6 L 7,6 Q 2,6 4,11</Geometry>
    <Geometry x:Key="Icon.Select">M 2,1 L 10,8 L 6.5,9 L 5,14 Z</Geometry>
    <Geometry x:Key="Icon.Delete">M 1,4 L 15,4 M 5,4 L 5,2 L 11,2 L 11,4 M 3,4 L 4,15 L 12,15 L 13,4 M 6.5,7 L 6.5,12 M 9.5,7 L 9.5,12</Geometry>
    <Geometry x:Key="Icon.FitAll">M 1,6 L 1,1 L 6,1 M 15,6 L 15,1 L 10,1 M 1,10 L 1,15 L 6,15 M 15,10 L 15,15 L 10,15</Geometry>
    <Geometry x:Key="Icon.ZoomIn">M 6.5,1.5 A 5,5 0 1,0 6.5,11.5 A 5,5 0 1,0 6.5,1.5 M 10.5,10.5 L 15,15 M 6.5,4 L 6.5,9 M 4,6.5 L 9,6.5</Geometry>
    <Geometry x:Key="Icon.ZoomOut">M 6.5,1.5 A 5,5 0 1,0 6.5,11.5 A 5,5 0 1,0 6.5,1.5 M 10.5,10.5 L 15,15 M 4,6.5 L 9,6.5</Geometry>
    <Geometry x:Key="Icon.Analyze">M 1,5 L 15,5 L 15,15 L 1,15 Z M 5,1 L 11,1 L 11,11 L 5,11 Z</Geometry>
    <Geometry x:Key="Icon.GapRepair">M 1,8 L 6,8 M 10,8 L 15,8 M 3.5,5.5 L 3.5,10.5 M 12.5,5.5 L 12.5,10.5 M 6.5,8 L 9.5,8</Geometry>

    <!--
        ToolbarIconButton — icon + optional short text, flat hover state.
        The icon is stroked with Toolbar.IconBrush and stays centered; the
        content presenter carries the (localized) short label.
    -->
    <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Viewbox x:Name="Icon" Width="16" Height="16" Margin="0,0,5,0">
                                <Path Data="{TemplateBinding Tag}" Stroke="{StaticResource Toolbar.IconBrush}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Layer.HoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0E9F2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Icon" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
