<Window x:Class="DxfContourStudio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DxfContourStudio.Wpf.Views"
        xmlns:loc="clr-namespace:DxfContourStudio.Wpf.Localization"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"        Height="720" Width="1240"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/DxfContourStudio.ico"
        Style="{StaticResource Typography.Window}">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding ActivateToolCommand}" CommandParameter="Join"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ActivateToolCommand}" CommandParameter="Break"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ActivateToolCommand}" CommandParameter="Trim"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ActivateToolCommand}" CommandParameter="Extend"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelToolCommand}"/>
        <KeyBinding Key="F" Command="{Binding ZoomToFitCommand}"/>
        <KeyBinding Key="F3" Command="{Binding ToggleSnapCommand}"/>
    </Window.InputBindings>

    <!--
        Layout contract (v0.2.0 productization):
        row 0 = menu (Auto), row 1 = toolbar (Auto), row 2 = workspace (*),
        row 3 = status bar (Auto, fixed 26px). The workspace itself is a
        3-column grid (left panels / viewport / right properties) plus a
        collapsible bottom diagnostics strip. The status bar never stretches
        vertically because it is not the last DockPanel child anymore.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= top menu ======================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="{loc:Loc Menu.File}">
                <MenuItem Header="{loc:Loc Menu.File.Open}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <MenuItem Header="{loc:Loc Menu.File.OpenProject}" Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="{loc:Loc Menu.File.Save}" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="{loc:Loc Menu.File.SaveAs}" Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="{loc:Loc Menu.File.ExportClean}" Command="{Binding ExportCleanDxfCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Menu.File.Exit}" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu.Edit}">
                <MenuItem Header="{loc:Loc Menu.Edit.Undo}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Redo}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Delete}" InputGestureText="Del" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.Select}"
                          Command="{Binding ActivateToolCommand}" CommandParameter="Select"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.NodeEdit}"
                          Command="{Binding ActivateToolCommand}" CommandParameter="NodeEdit"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.Join}" InputGestureText="Ctrl+J"
                          Command="{Binding ActivateToolCommand}" CommandParameter="Join"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.Break}" InputGestureText="Ctrl+B"
                          Command="{Binding ActivateToolCommand}" CommandParameter="Break"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.Trim}" InputGestureText="Ctrl+T"
                          Command="{Binding ActivateToolCommand}" CommandParameter="Trim"/>
                <MenuItem Header="{loc:Loc Menu.Edit.Tools.Extend}" InputGestureText="Ctrl+E"
                          Command="{Binding ActivateToolCommand}" CommandParameter="Extend"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Menu.Edit.SelectAll}" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="{loc:Loc Menu.Edit.ClearSelection}" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu.View}">
                <MenuItem Header="{loc:Loc Menu.View.FitAll}" Command="{Binding ZoomToFitCommand}"/>
                <MenuItem Header="{loc:Loc Menu.View.ZoomIn}" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="{loc:Loc Menu.View.ZoomOut}" Command="{Binding ZoomOutCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Menu.View.ShowAllLayers}" Command="{Binding ShowAllLayersCommand}"/>
                <MenuItem Header="{loc:Loc Menu.View.HideAllLayers}" Command="{Binding HideAllLayersCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu.Analyze}">
                <MenuItem Header="{loc:Loc Menu.Analyze.Contours}" Command="{Binding AnalyzeCommand}"/>
                <MenuItem Header="{loc:Loc Menu.Analyze.Diagnostics}" Command="{Binding AnalyzeCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu.Tools}">
                <MenuItem Header="{loc:Loc Menu.Tools.Settings}" IsEnabled="False"
                          ToolTip="{loc:Loc Command.Later}"/>
                <MenuItem Header="{loc:Loc Menu.Tools.Snap}" IsCheckable="True"
                          InputGestureText="F3" IsChecked="{Binding SnapMasterEnabled}"/>
                <MenuItem Header="{loc:Loc Menu.Tools.SnapSettings}">
                    <MenuItem Header="{loc:Loc Snap.Kind.Endpoint}" IsCheckable="True"
                              IsChecked="{Binding SnapEndpointEnabled}"/>
                    <MenuItem Header="{loc:Loc Snap.Kind.Midpoint}" IsCheckable="True"
                              IsChecked="{Binding SnapMidpointEnabled}"/>
                    <MenuItem Header="{loc:Loc Snap.Kind.Center}" IsCheckable="True"
                              IsChecked="{Binding SnapCenterEnabled}"/>
                    <MenuItem Header="{loc:Loc Snap.Kind.Intersection}" IsCheckable="True"
                              IsChecked="{Binding SnapIntersectionEnabled}"/>
                    <MenuItem Header="{loc:Loc Snap.Kind.Nearest}" IsCheckable="True"
                              IsChecked="{Binding SnapNearestEnabled}"/>
                </MenuItem>
                <MenuItem Header="{loc:Loc Menu.Tools.Language}">
                    <MenuItem Header="{loc:Loc Menu.Tools.Language.ZhCn}"
                              IsCheckable="True" IsChecked="{Binding IsZhCulture}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="zh-CN"/>
                    <MenuItem Header="{loc:Loc Menu.Tools.Language.Us}"
                              IsCheckable="True" IsChecked="{Binding IsEnCulture}"
                              Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu.Help}">
                <MenuItem Header="{loc:Loc Menu.Help.About}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ======================= toolbar ======================= -->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button AutomationProperties.AutomationId="Toolbar.Open" Tag="{StaticResource Icon.Open}" ToolTip="{loc:Loc Tooltip.Open}"
                        Command="{Binding OpenCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button AutomationProperties.AutomationId="Toolbar.OpenProject" Tag="{StaticResource Icon.Open}" ToolTip="{loc:Loc Tooltip.Save}"
                        Command="{Binding OpenProjectCommand}" Style="{StaticResource ToolbarIconButton}" Opacity="0.75"/>
                <Button AutomationProperties.AutomationId="Toolbar.Save" Tag="{StaticResource Icon.Save}" ToolTip="{loc:Loc Tooltip.Save}"
                        Command="{Binding SaveProjectCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button AutomationProperties.AutomationId="Toolbar.ExportClean" Tag="{StaticResource Icon.Save}" ToolTip="{loc:Loc Tooltip.ExportClean}"
                        Command="{Binding ExportCleanDxfCommand}" Style="{StaticResource ToolbarIconButton}" Opacity="0.75"/>
                <Separator/>
                <Button AutomationProperties.AutomationId="Toolbar.Undo" Tag="{StaticResource Icon.Undo}" ToolTip="{loc:Loc Tooltip.Undo}"
                        Command="{Binding UndoCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button AutomationProperties.AutomationId="Toolbar.Redo" Tag="{StaticResource Icon.Redo}" ToolTip="{loc:Loc Tooltip.Redo}"
                        Command="{Binding RedoCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Separator/>
                <Button Tag="{StaticResource Icon.Select}" ToolTip="{loc:Loc Tooltip.Select}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="Select"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.NodeEdit}" ToolTip="{loc:Loc Tooltip.NodeEdit}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="NodeEdit"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ToolJoin}" ToolTip="{loc:Loc Tooltip.Join}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="Join"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ToolBreak}" ToolTip="{loc:Loc Tooltip.Break}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="Break"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ToolTrim}" ToolTip="{loc:Loc Tooltip.Trim}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="Trim"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ToolExtend}" ToolTip="{loc:Loc Tooltip.Extend}"
                        Command="{Binding ActivateToolCommand}" CommandParameter="Extend"
                        Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.Delete}" ToolTip="{loc:Loc Tooltip.Delete}"
                        Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Separator/>
                <Button Tag="{StaticResource Icon.FitAll}" ToolTip="{loc:Loc Tooltip.FitAll}"
                        Command="{Binding ZoomToFitCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ZoomIn}" ToolTip="{loc:Loc Tooltip.ZoomIn}"
                        Command="{Binding ZoomInCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button Tag="{StaticResource Icon.ZoomOut}" ToolTip="{loc:Loc Tooltip.ZoomOut}"
                        Command="{Binding ZoomOutCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Separator/>
                <Button AutomationProperties.AutomationId="Toolbar.Analyze" Tag="{StaticResource Icon.Analyze}" ToolTip="{loc:Loc Tooltip.Analyze}"
                        Command="{Binding AnalyzeCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button AutomationProperties.AutomationId="Toolbar.RepairGap" Tag="{StaticResource Icon.GapRepair}" ToolTip="{loc:Loc Tooltip.Repair}"
                        Command="{Binding RepairSelectedGapCommand}" Style="{StaticResource ToolbarIconButton}"/>
                <Button AutomationProperties.AutomationId="Toolbar.RepairAll" Tag="{StaticResource Icon.GapRepair}" ToolTip="{loc:Loc Tooltip.RepairAll}"
                        Command="{Binding RepairAllSafeGapsCommand}" Style="{StaticResource ToolbarIconButton}" Opacity="0.75"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ======================= workspace ======================= -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="DiagnosticsRow" Height="180" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- main row: left panels | viewport | right properties -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="220" MaxWidth="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="290" MinWidth="260" MaxWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- ============ left panel: layers / contours ============ -->
                <TabControl Grid.Column="0" Margin="4,4,0,4">
                    <TabItem Header="{loc:Loc Panel.Layers}">
                        <DockPanel Margin="4">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="{loc:Loc Layer.ShowAll}" ToolTip="{loc:Loc Layer.ShowAllTip}"
                                            Command="{Binding ShowAllLayersCommand}" Padding="8,2" Margin="4,0,0,0"/>
                                    <Button Content="{loc:Loc Layer.HideAll}" ToolTip="{loc:Loc Layer.HideAllTip}"
                                            Command="{Binding HideAllLayersCommand}" Padding="8,2" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- column headers: 可见 | 图层 | 数量 -->
                                <Grid Grid.Row="0" Background="{StaticResource Layer.HeaderBrush}" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Layer.Col.Visible}"
                                               Style="{StaticResource Typography.SmallText}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Layer.Col.Layer}"
                                               Style="{StaticResource Typography.SmallText}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Layer.Col.Count}"
                                               Style="{StaticResource Typography.SmallText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding LayerRows}" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding EntityCount}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{loc:Loc Panel.Contours}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- summary line: 总数 / 闭合 / 开口 / 小间隙 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{loc:Loc Contours.Total}" Style="{StaticResource Typography.SmallText}"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding AnalysisResult.ClosedCount}" Margin="2,0,10,0"
                                           Style="{StaticResource Typography.SmallText}"/>
                                <TextBlock Text="{loc:Loc Contours.Closed}" Style="{StaticResource Typography.SmallText}"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding AnalysisResult.OpenCount}" Margin="2,0,10,0"
                                           Style="{StaticResource Typography.SmallText}"/>
                                <TextBlock Text="{loc:Loc Contours.GapCount}" Style="{StaticResource Typography.SmallText}"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding AnalysisResult.SmallGapCount}" Margin="2,0,0,0"
                                           Style="{StaticResource Typography.SmallText}"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <!-- empty state -->
                                <TextBlock Text="{loc:Loc Contours.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContoursEmptyVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- contour rows: id | type | summary -->
                                <ListBox ItemsSource="{Binding ContourItems}" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IdText}"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                <!-- ============ viewport ============ -->
                <Grid Grid.Column="2" Margin="0,4">
                    <views:CadViewport x:Name="ViewportControl" Margin="1" Focusable="True"/>
                    <!-- empty state (no drag & drop: the hint points to Open) -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="{loc:Loc Viewport.Empty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Viewport.EmptyStateTextBrush}"
                               FontSize="14" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmptyViewportVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                <!-- ============ right panel: properties ============ -->
                <GroupBox Grid.Column="4" Header="{loc:Loc Panel.Properties}" Margin="0,4,4,4" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- empty state when nothing is selected -->
                            <StackPanel x:Name="PropsEmptyState" Margin="4">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PropsEmptyVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Loc Props.Empty.Title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{loc:Loc Props.Empty.Hint}" TextWrapping="Wrap"
                                           Style="{StaticResource Typography.SmallText}"/>
                            </StackPanel>
                            <!-- grouped property rows -->
                            <ItemsControl x:Name="PropsGroups" ItemsSource="{Binding PropertyGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" Margin="0,2,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

            <!-- ============ bottom strip: diagnostics + import report ============ -->
            <TabControl Grid.Row="2" Margin="4">
                <TabItem Header="{loc:Loc Panel.Diagnostics}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- stale-analysis banner: any geometry edit invalidates
                             the previous diagnostics until the user re-runs Analyze. -->
                        <Border Grid.Row="0" Background="{StaticResource DiagnosticWarning}" Padding="6,3" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Status.AnalysisStale}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextOnAccent}" TextTrimming="CharacterEllipsis"/>
                                <Button Content="{loc:Loc Menu.Analyze.Contours}" Margin="10,0,0,0"
                                        Command="{Binding AnalyzeCommand}" Padding="10,1"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnalysisStale}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Contours.Repair}"
                                    ToolTip="{loc:Loc Tooltip.Repair}" Command="{Binding RepairSelectedGapCommand}"
                                    Padding="10,2"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Toolbar.RepairAll}"
                                    ToolTip="{loc:Loc Tooltip.RepairAll}" Command="{Binding RepairAllSafeGapsCommand}"
                                    Padding="10,2" Margin="0,0,6,0"/>
                            <ToggleButton DockPanel.Dock="Right" Content="{loc:Loc Diag.Collapse}"
                                          ToolTip="{loc:Loc Diag.CollapseTip}" Margin="0,0,6,0"
                                          Padding="8,2" IsChecked="{Binding DiagnosticsCollapsed}"
                                          Checked="OnDiagnosticsToggle" Unchecked="OnDiagnosticsToggle"/>
                            <TextBlock Text="{loc:Loc Panel.Diagnostics}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <!-- empty state -->
                            <TextBlock Text="{loc:Loc Diag.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiagnosticsEmptyVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- diagnostic rows: severity | type | detail | position | entity -->
                            <ListBox x:Name="DiagnosticsList" ItemsSource="{Binding DiagnosticItems}"
                                     SelectedItem="{Binding SelectedDiagnostic}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SeverityText}"
                                                       FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DiagnosticWarning}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DiagnosticError}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PositionText}"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding EntityText}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Panel.Import}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <!-- empty state -->
                            <TextBlock x:Name="ReportEmptyState" Text="{loc:Loc Report.Empty}"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReportEmptyVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- label/value rows -->
                            <ItemsControl x:Name="ReportRows" ItemsSource="{Binding ImportReportItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- entity statistics -->
                            <TextBlock Text="{loc:Loc Report.StatisticsTitle}" FontWeight="SemiBold"
                                       Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding EntityStatItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TypeName}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ======================= status bar ======================= -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding CursorStatus}" MinWidth="220"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ZoomStatus}" MinWidth="70"/>
                    <TextBlock Text="{Binding UnitStatus}" MinWidth="80" Margin="10,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding EntityCountStatus}" MinWidth="90"/>
                    <TextBlock Text="{Binding SelectedCountStatus}" MinWidth="90" Margin="10,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SnapStatusText}" MinWidth="110" Margin="0,0,6,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ToolStatusText}" MinWidth="80" Margin="0,0,6,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileNameTooltip}"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
