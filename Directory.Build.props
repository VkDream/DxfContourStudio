<Project>

  <!--
    Directory.Build.props — single source of truth for product versioning.

    Every project under this repo inherits these properties, so the WPF app
    assembly, the tests and any future tooling all report the same version.
    Product version policy is documented in docs/ADR/ADR-006-Versioning.md.

    0.3.0-dev     (unreleased development version of the v0.2.0 public release;
                   VersionSuffix "dev" marks a non-release build)
    Version        = 0.3.0-dev      (product / NuGet-style semantic version)
    AssemblyVersion= 0.3.0.0        (CLR assembly version, 4 components)
    FileVersion    = 0.3.0.0        (Windows file version, 4 components)
    Informational  = 0.3.0-dev      (product display version incl. metadata)
  -->

  <PropertyGroup>
    <Version>0.3.0-dev</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0-dev</InformationalVersion>
  </PropertyGroup>

</Project>
