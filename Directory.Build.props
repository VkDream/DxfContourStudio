<Project>

  <!--
    Directory.Build.props — single source of truth for product versioning.

    Every project under this repo inherits these properties, so the WPF app
    assembly, the tests and any future tooling all report the same version.
    Product version policy is documented in docs/ADR/ADR-006-Versioning.md.

    Version        = 0.2.0          (product / NuGet-style semantic version)
    AssemblyVersion= 0.2.0.0        (CLR assembly version, 4 components)
    FileVersion    = 0.2.0.0        (Windows file version, 4 components)
    Informational  = 0.2.0          (product display version incl. metadata)
  -->

  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
  </PropertyGroup>

</Project>
