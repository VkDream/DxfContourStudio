<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DxfContourStudio.Core\DxfContourStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\DxfContourStudio.Dxf\DxfContourStudio.Dxf.csproj" />
    <ProjectReference Include="..\..\src\DxfContourStudio.Application\DxfContourStudio.Application.csproj" />
    <ProjectReference Include="..\..\src\DxfContourStudio.Wpf\DxfContourStudio.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\testdata\dxf\*.dxf" Link="testdata\dxf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\DxfContourStudio.Wpf\MainWindow.xaml" Link="src\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>